{%- comment -%}
  ============================================================================
  HOLIDAY SALES BAR — Custom Liquid version (no schema, no theme-editor UI)
  ----------------------------------------------------------------------------
  Same auto-recurring calendar + countdown/flash timer as the section, but all
  settings are variables in the EDIT HERE block below. Downsides vs the section:
  no editor controls, no repeatable "extra sale" blocks (edit the calendar
  array by hand), and sticky/announcement placement is weaker. Prefer the
  section unless you specifically need this inline.

  Record: start | end | priority | flash_from | bg | text | accent | line1 | line2
    start/end/flash_from : MM-DD (year ignored). start > end wraps the year.
    flash_from : LAST day of the countdown (deadline). Flash rolls over AFTER it.
  ============================================================================
{%- endcomment -%}

{%- liquid
  # ===== EDIT HERE =========================================================
  assign flash_minutes = 120
  assign timer_switch_hours = 48
  assign always_seconds = true

  assign timer_box_color = '#FFFFFF'
  assign timer_digit_color = '#111111'
  assign timer_label_color = '#888888'

  assign show_default = true
  assign default_headline_1 = '⚡ FLASH SALE'
  assign default_headline_2 = 'UP TO 25% OFF SITEWIDE'
  assign default_bg_color = '#D83C36'
  assign default_bg_gradient = ''
  assign default_text_color = '#FFFFFF'
  assign default_accent_color = '#D83C36'
  assign default_url = ''
  assign default_enable_timer = true
  assign default_timer_mode = 'window'
  assign default_rolling_hours = 2
  assign default_rolling_minutes = 0

  assign visibility = 'always-display'
  assign custom_section_id = ''

  assign hidden_products = ''
  assign enable_specific_display = false
  assign displayed_products = ''

  assign padding_top = 0
  assign padding_bottom = 0
  # ===== END EDIT ==========================================================

  assign uid = section.id | default: 'hsb'
-%}

