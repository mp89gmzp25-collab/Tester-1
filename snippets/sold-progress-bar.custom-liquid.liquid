{%- comment -%}
  ============================================================================
  "X% SOLD" SCARCITY BAR — Custom Liquid (strict) — SVG version (bulletproof)
  Dova · Shopify
  ============================================================================
  The bar is drawn as an inline SVG. The red is a fill="" ATTRIBUTE on a
  <rect>, not a CSS background — so page builders (GemPages) that strip CSS
  backgrounds can't remove it. Edit the EDIT HERE block. {p} = percent number.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign percent = 93
  assign label = '{p}% Sold'

  assign fill_color  = '#C0463B'
  assign track_color = '#E7E7E7'
  assign label_color = '#C27A70'
  assign bar_height = 14

  if percent > 100
    assign percent = 100
  endif
  if percent < 0
    assign percent = 0
  endif
  assign rx = bar_height | divided_by: 2
  assign label = label | replace: '{p}', percent
-%}

<div style="display:flex;align-items:center;gap:16px;margin:12px 0;font-family:inherit;">
  <svg
    width="100%"
    height="{{ bar_height }}"
    style="display:block;flex:1 1 auto;"
    role="progressbar"
    aria-valuenow="{{ percent }}"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-label="{{ label | strip_html | escape }}"
  >
    <rect x="0" y="0" width="100%" height="{{ bar_height }}" rx="{{ rx }}" fill="{{ track_color }}"></rect>
    <rect x="0" y="0" width="{{ percent }}%" height="{{ bar_height }}" rx="{{ rx }}" fill="{{ fill_color }}"></rect>
  </svg>
  <span style="flex:0 0 auto;color:{{ label_color }};font-size:clamp(15px,4vw,18px);font-weight:700;line-height:1;white-space:nowrap;">{{ label }}</span>
</div>
