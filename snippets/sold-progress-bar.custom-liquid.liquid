{%- comment -%}
  ============================================================================
  "X% SOLD" SCARCITY BAR — Custom Liquid (strict) — single-element gradient
  Dova · Shopify
  ============================================================================
  The bar is ONE div: a left-to-right gradient that is fill_color up to the
  percent, then track_color after. No nested fill element (page builders
  sometimes strip those), so the red always paints. Edit the EDIT HERE block.
  {p} in the label = the percent number.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign percent = 93
  assign label = '{p}% Sold'

  assign fill_color  = '#C0463B'
  assign track_color = '#E7E7E7'
  assign label_color = '#C27A70'
  assign card_bg     = '#FFFFFF'

  assign show_card = true
  assign show_glow = true
  assign bar_height = 14

  if percent > 100
    assign percent = 100
  endif
  if percent < 0
    assign percent = 0
  endif
  assign label = label | replace: '{p}', percent

  assign card_css = ''
  if show_card
    assign card_css = 'background:' | append: card_bg | append: ';border-radius:16px;box-shadow:0 4px 18px rgba(16,24,40,0.06);padding:22px 24px;'
  endif

  assign glow_css = ''
  if show_glow
    assign glow_css = 'box-shadow:0 0 10px 1px ' | append: fill_color | append: '55;'
  endif

  assign bar_bg = 'linear-gradient(to right,' | append: fill_color | append: ' 0%,' | append: fill_color | append: ' ' | append: percent | append: '%,' | append: track_color | append: ' ' | append: percent | append: '%,' | append: track_color | append: ' 100%)'
-%}

<div style="font-family:inherit;margin:12px 0;{{ card_css }}">
  <div
    role="progressbar"
    aria-valuenow="{{ percent }}"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-label="{{ label | strip_html | escape }}"
    style="display:flex;align-items:center;gap:16px;"
  >
    <div style="flex:1 1 auto;height:{{ bar_height }}px;border-radius:999px;background:{{ bar_bg }};{{ glow_css }}"></div>
    <span style="flex:0 0 auto;color:{{ label_color }};font-size:clamp(15px,4vw,18px);font-weight:700;line-height:1;white-space:nowrap;">{{ label }}</span>
  </div>
</div>
