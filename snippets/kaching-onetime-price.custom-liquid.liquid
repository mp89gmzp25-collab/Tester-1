{%- comment -%}
  ============================================================================
  KACHING BUNDLES — TIER-DRIVEN one-time price.  (Custom Liquid, drop-in) v3
  Dova Probiotics Oral Spray PDP · Shopify · Navidium theme
  ============================================================================

  BEHAVIOUR
  - Watches which bundle bar is currently SELECTED in the Kaching widget.
  - Reads that bar's DISCOUNTED price (.kaching-bundles__bar-price).
  - Adds CONFIG.offset (default 10) in the displayed currency.
  - Renders the result where %%PRICE%% sits in the one-time toggle.
  - Recomputes live on every tier change (click + attribute observer + poll).

  Verify (GBP): Buy 1 £22.95 → £32.95 · Buy 2 £44.95 → £54.95 · Buy 3 £59.95 → £69.95

  SETUP
  1) App → Subscriptions → "One-time title" = exactly:  One-time purchase %%PRICE%%
     (plain static text — no {} picker). Save + Publish.
  2) Product template → "Custom Liquid" block → paste this whole file.
  3) Set debug=true if the label doesn't update — the console logs the
     selected bar it found and the price math.

  OFFSET / CURRENCY NOTE
  offset is added as a NUMBER in whatever currency the bar shows: +10 → +£10
  in GBP, +$10 in USD, +€10 in EUR. This matches the merchant's per-tier
  targets. It is NOT an FX-converted £10 — a true converted uplift would need
  a live rate source; say so if that's wanted.

  SELECTED-BAR DETECTION
  Tries known "selected" classes/attributes, then a checked radio inside a
  bar, then any bar whose class looks selected. If none match, debug logs
  every bar's class so you can send me the exact hook.
  ============================================================================
{%- endcomment -%}

<script>
(function () {
  'use strict';

  var CONFIG = {
    token: '%%PRICE%%',
    offset: 10,                                   // added in the displayed currency

    barSelector: '.kaching-bundles__bar',
    barPriceSelector: '.kaching-bundles__bar-price',   // discounted price (NOT -bar-full-price)

    // Known ways Kaching may mark the active bar. First match wins; the
    // detector also falls back to checked radios / "selected"-looking classes.
    selectedBarSelectors: [
      '.kaching-bundles__bar--selected',
      '.kaching-bundles__bar.is-selected',
      '.kaching-bundles__bar.selected',
      '.kaching-bundles__bar--active',
      '.kaching-bundles__bar[aria-selected="true"]',
      '.kaching-bundles__bar[aria-checked="true"]',
      '.kaching-bundles__bar[data-selected="true"]'
    ],

    debug: false,
    debounceMs: 90
  };

  var SKIP = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1 };

  function log() { if (CONFIG.debug && window.console) console.log.apply(console, ['[onetime]'].concat([].slice.call(arguments))); }
  function clean(s) { return (s || '').trim().replace(/\s+/g, ' '); }

  // ---- locale-aware money + offset -----------------------------------------
  // Parses a rendered price string, adds `offset`, and reformats keeping the
  // same currency symbol/placement, decimal char, grouping char and decimals.
  function addOffset(raw, offset) {
    var s = String(raw).trim();
    var m = s.match(/^([^\d]*?)(\d[\d.,   ]*\d|\d)([^\d]*)$/);
    if (!m) return null;
    var prefix = m[1], numRaw = m[2], suffix = m[3];

    var hasComma = numRaw.indexOf(',') !== -1;
    var hasDot = numRaw.indexOf('.') !== -1;

    var decimalSep = '';
    if (hasComma && hasDot) {
      decimalSep = numRaw.lastIndexOf(',') > numRaw.lastIndexOf('.') ? ',' : '.';
    } else if (hasComma || hasDot) {
      var only = hasComma ? ',' : '.';
      var occurrences = numRaw.split(only).length - 1;
      var after = numRaw.slice(numRaw.lastIndexOf(only) + 1).replace(/[^\d]/g, '');
      // Single separator followed by 3 digits, or repeated → grouping (integer).
      decimalSep = (occurrences > 1 || after.length === 3) ? '' : only;
    }

    var decimals = decimalSep ? numRaw.slice(numRaw.lastIndexOf(decimalSep) + 1).replace(/[^\d]/g, '').length : 0;

    // Grouping char to use when reformatting.
    var spaceMatch = numRaw.match(/[   ]/);
    var groupingSep;
    if (decimalSep === ',') groupingSep = hasDot ? '.' : (spaceMatch ? spaceMatch[0] : '.');
    else if (decimalSep === '.') groupingSep = hasComma ? ',' : (spaceMatch ? spaceMatch[0] : ',');
    else groupingSep = (numRaw.match(/[.,   ]/) || [','])[0];

    // Normalize to a JS float.
    var normalized;
    if (decimalSep) {
      normalized = numRaw.replace(new RegExp('[^\\d' + (decimalSep === '.' ? '\\.' : decimalSep) + ']', 'g'), '');
      normalized = normalized.replace(decimalSep, '.');
    } else {
      normalized = numRaw.replace(/[^\d]/g, '');
    }
    var value = parseFloat(normalized);
    if (isNaN(value)) return null;

    var fixed = (value + offset).toFixed(decimals);
    var parts = fixed.split('.');
    var intPart = parts[0];
    var fracPart = parts[1] || '';
    if (groupingSep) intPart = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, groupingSep);

    return prefix + intPart + (decimals > 0 ? decimalSep + fracPart : '') + suffix;
  }

  // ---- selected bar --------------------------------------------------------
  // Returns a "why it's selected" reason string, or '' if this bar is not it.
  function selectedReason(bar) {
    try { if (bar.matches && bar.matches(CONFIG.selectedBarSelectors.join(','))) return 'known-selector'; } catch (e) {}
    if (/(?:--selected|is-selected|\bselected\b|--active|is-active|\bactive\b|current|is-checked)/i.test(bar.className || '')) return 'class:' + bar.className;
    if (bar.getAttribute) {
      if (bar.getAttribute('aria-selected') === 'true') return 'aria-selected';
      if (bar.getAttribute('aria-checked') === 'true') return 'aria-checked';
      if (bar.getAttribute('data-selected') === 'true' || bar.getAttribute('data-selected') === '') return 'data-selected';
      if (bar.getAttribute('data-active') === 'true') return 'data-active';
    }
    if (bar.querySelector) {
      if (bar.querySelector('input:checked')) return 'input:checked';
      if (bar.querySelector('[aria-checked="true"]')) return 'inner-aria-checked';
      if (bar.querySelector('[class*="selected" i],[class*="is-active" i],[class*="--active" i]')) return 'inner-selected-class';
    }
    return '';
  }

  function borderWeight(bar) {
    try {
      var cs = getComputedStyle(bar);
      return (parseFloat(cs.borderTopWidth) || 0) + (parseFloat(cs.outlineWidth) || 0) +
             (/(?:inset|rgba?\()/.test(cs.boxShadow) && cs.boxShadow !== 'none' ? 3 : 0);
    } catch (e) { return 0; }
  }

  function getSelectedBar() {
    var bars = [].slice.call(document.querySelectorAll(CONFIG.barSelector));
    if (!bars.length) { log('NO bars found for', CONFIG.barSelector, '— check barSelector'); return null; }

    // 1) Explicit selection signals.
    for (var i = 0; i < bars.length; i++) {
      var reason = selectedReason(bars[i]);
      if (reason) { log('selected bar = index', i, 'via', reason); return bars[i]; }
    }

    // 2) Visual fallback: the bar with the heaviest border/outline/shadow.
    var maxI = -1, maxW = -1, tie = false;
    for (var j = 0; j < bars.length; j++) {
      var w = borderWeight(bars[j]);
      if (w > maxW) { maxW = w; maxI = j; tie = false; }
      else if (w === maxW) tie = true;
    }
    if (maxI >= 0 && maxW > 0 && !tie) {
      log('selected bar = index', maxI, 'via visual-border (weight', maxW + ')');
      return bars[maxI];
    }

    // 3) Give up — dump full diagnostics so we can pin the real hook.
    log('FALLBACK FAILED — no selection signal on any bar. Per-bar diagnostics:',
        bars.map(function (b, k) {
          return {
            index: k,
            className: b.className,
            ariaSelected: b.getAttribute && b.getAttribute('aria-selected'),
            ariaChecked: b.getAttribute && b.getAttribute('aria-checked'),
            dataSelected: b.getAttribute && b.getAttribute('data-selected'),
            hasCheckedInput: !!(b.querySelector && b.querySelector('input:checked')),
            borderWeight: borderWeight(b),
            outerHTMLhead: (b.outerHTML || '').slice(0, 160)
          };
        }));
    return null;
  }

  function computeOneTimePrice() {
    var bar = getSelectedBar();
    if (!bar) { log('no selected bar → not updating (label keeps last value)'); return ''; }
    // Read the DISCOUNTED price. .bar-price never matches .bar-full-price (different
    // class token); we also explicitly reject the original-price a11y node as a guard.
    var priceEl = bar.querySelector(CONFIG.barPriceSelector + ':not([data-a11y-label="system.original_price"])')
               || bar.querySelector(CONFIG.barPriceSelector);
    if (!priceEl) { log('selected bar (', bar.className, ') has no', CONFIG.barPriceSelector); return ''; }
    if (priceEl.getAttribute && priceEl.getAttribute('data-a11y-label') === 'system.original_price') {
      log('WARNING: matched node is original_price — check barPriceSelector', priceEl);
    }
    var raw = clean(priceEl.textContent);
    var out = addOffset(raw, CONFIG.offset);
    if (!out) { log('could not parse price:', raw); return ''; }
    log('bar-price', JSON.stringify(raw), '(a11y:', (priceEl.getAttribute && priceEl.getAttribute('data-a11y-label')) + ') +', CONFIG.offset, '=', JSON.stringify(out));
    return out;
  }

  // ---- injection -----------------------------------------------------------
  function getRoots() {
    var list = [document.body];
    var all = document.querySelectorAll('*');
    for (var i = 0; i < all.length; i++) if (all[i].shadowRoot) list.push(all[i].shadowRoot);
    return list;
  }
  function queryAllRoots(sel) {
    var out = [], roots = getRoots();
    for (var i = 0; i < roots.length; i++) { if (!roots[i].querySelectorAll) continue; var f = roots[i].querySelectorAll(sel); for (var j = 0; j < f.length; j++) out.push(f[j]); }
    return out;
  }

  function injectOrUpdate() {
    var price = computeOneTimePrice();
    if (!price) return;

    var existing = queryAllRoots('[data-onetime-price]');
    if (existing.length) {
      for (var i = 0; i < existing.length; i++) if (existing[i].textContent !== price) existing[i].textContent = price;
      return;
    }

    var roots = getRoots();
    for (var r = 0; r < roots.length; r++) {
      var rootNode = roots[r].body ? roots[r].body : roots[r];
      if (!rootNode) continue;
      var walker = document.createTreeWalker(rootNode, NodeFilter.SHOW_TEXT, {
        acceptNode: function (n) {
          if (!n.nodeValue || n.nodeValue.indexOf(CONFIG.token) === -1) return NodeFilter.FILTER_REJECT;
          if (n.parentNode && SKIP[n.parentNode.nodeName]) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        }
      });
      var node = walker.nextNode();
      if (!node) continue;

      var idx = node.nodeValue.indexOf(CONFIG.token);
      var span = document.createElement('span');
      span.setAttribute('data-onetime-price', '');
      span.textContent = price;
      var frag = document.createDocumentFragment();
      var before = node.nodeValue.slice(0, idx);
      var after = node.nodeValue.slice(idx + CONFIG.token.length);
      if (before) frag.appendChild(document.createTextNode(before));
      frag.appendChild(span);
      if (after) frag.appendChild(document.createTextNode(after));
      node.parentNode.replaceChild(frag, node);
      log('injected');
      return;
    }
  }

  var timer = null;
  function schedule() { if (timer) clearTimeout(timer); timer = setTimeout(injectOrUpdate, CONFIG.debounceMs); }

  schedule();
  document.addEventListener('DOMContentLoaded', schedule);
  window.addEventListener('load', schedule);

  // Tier changes: click on any bar…
  document.addEventListener('click', function (e) {
    if (e.target && e.target.closest && e.target.closest(CONFIG.barSelector)) schedule();
  }, true);

  // …selected-state class/attr flips + widget re-render…
  new MutationObserver(schedule).observe(document.documentElement, {
    childList: true, subtree: true, characterData: true,
    attributes: true, attributeFilter: ['class', 'aria-selected', 'aria-checked', 'data-selected']
  });

  // …theme variant events, and a short startup poll for late render.
  ['variant:change', 'variantChange', 'product:variant-change', 'on:variant:change', 'change']
    .forEach(function (ev) { document.addEventListener(ev, schedule, true); });
  var polls = 0, pid = setInterval(function () { schedule(); if (++polls >= 17) clearInterval(pid); }, 300); // ~5s
})();
</script>
