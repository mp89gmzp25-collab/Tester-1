{%- comment -%}
  ============================================================================
  KACHING BUNDLES — inject the TRUE single-unit price into the
  "One-time purchase" toggle label.  (Custom Liquid, drop-in) — v2 self-detect
  Dova Probiotics Oral Spray PDP · Shopify · Navidium theme
  ============================================================================

  WHAT IT DOES
  Copies the price string the THEME renders for the current variant (already
  currency/market-correct) into the Kaching one-time toggle. Reads the theme
  price — NOT the widget — so it's independent of the selected bundle bar,
  and re-copies on variant change / widget re-render.

  v2 CHANGES (why your paste showed the raw %%PRICE%%)
  - Accepts the theme price even when it's HIDDEN behind the bundle widget
    (the text is still in the DOM and still market-converted).
  - IGNORES anything inside the Kaching widget, so it can't grab a bundle
    bar's price by accident.
  - Set CONFIG.debug = true to log what it found (or didn't) in the console.

  SETUP
  1) App → Subscriptions → "One-time title" = exactly:  One-time purchase %%PRICE%%
     (plain static text — do NOT use the {} picker for the price). Save + Publish.
  2) Product template → add a "Custom Liquid" block → paste this whole file.
     Usually works with the pre-filled selectors. If not, set debug=true, open
     the product page console, and follow the logged hint.

  OFFSET (+$10 etc.): raise the Shopify product price. Never do money math here
  — parsing a localized string breaks across markets.
  ============================================================================
{%- endcomment -%}

<script>
(function () {
  'use strict';

  var CONFIG = {
    token: '%%PRICE%%',

    // Theme price element(s). First good match wins (visible preferred, but
    // HIDDEN is accepted). Add your theme's selector to the FRONT if needed.
    themePriceSelectors: [
      '.price__container .price-item--regular',
      '.price__container .price-item--sale:not([hidden])',
      '.price-item--regular',
      '.price-item--sale:not([hidden])',
      '.price__regular .price-item',
      '[data-product-price]',
      '.product__price',
      '.product-price',
      '.price'
    ],

    // Subtrees to EXCLUDE from the price search (the bundle widget itself).
    excludeSelectors:
      '[class*="kaching" i],[id*="kaching" i],[class*="qbf" i],[class*="qb-" i],' +
      '[data-kaching-bundles],[class*="bundle-deal" i],[class*="kb-widget" i],' +
      '[class*="kaCrafter" i]',

    debug: false,
    debounceMs: 120
  };

  var MONEY = /(?:[£$€¥₹]|USD|GBP|EUR|CAD|AUD)\s?\d|\d[.,]\d{2}/i;
  var SKIP = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1 };

  function log() { if (CONFIG.debug && window.console) console.log.apply(console, ['[onetime]'].concat([].slice.call(arguments))); }

  function isVisible(el) {
    if (!el) return false;
    var r = el.getClientRects();
    return !!(r && r.length);
  }

  function insideWidget(el) {
    return !!(el.closest && el.closest(CONFIG.excludeSelectors));
  }

  // Find the theme's single-unit price, hidden or not, outside the widget.
  function getThemePrice() {
    var candidates = [];
    for (var i = 0; i < CONFIG.themePriceSelectors.length; i++) {
      var els;
      try { els = document.querySelectorAll(CONFIG.themePriceSelectors[i]); }
      catch (e) { continue; }
      for (var j = 0; j < els.length; j++) {
        var el = els[j];
        if (insideWidget(el)) continue;
        var txt = (el.textContent || '').trim().replace(/\s+/g, ' ');
        if (!txt || !MONEY.test(txt)) continue;
        candidates.push({ el: el, txt: txt, visible: isVisible(el), rank: i });
      }
    }
    if (!candidates.length) {
      log('NO price found. Add your theme price selector to themePriceSelectors[0]. ' +
          'Run this in console to find it:',
          "[...document.querySelectorAll('body *')].filter(e=>e.children.length===0&&/^[£$€]\\s?\\d/.test(e.textContent.trim())).map(e=>e.tagName+'.'+[...e.classList].join('.')+' → '+e.textContent.trim())");
      return '';
    }
    // Prefer a visible node; among equals, the earliest (most specific) selector.
    candidates.sort(function (a, b) {
      if (a.visible !== b.visible) return a.visible ? -1 : 1;
      return a.rank - b.rank;
    });
    log('price =', candidates[0].txt, '(visible:', candidates[0].visible + ')', candidates[0].el);
    return candidates[0].txt;
  }

  function getRoots() {
    var list = [document.body];
    var all = document.querySelectorAll('*');
    for (var i = 0; i < all.length; i++) if (all[i].shadowRoot) list.push(all[i].shadowRoot);
    return list;
  }

  function queryAllRoots(sel) {
    var out = [], roots = getRoots();
    for (var i = 0; i < roots.length; i++) {
      if (!roots[i].querySelectorAll) continue;
      var f = roots[i].querySelectorAll(sel);
      for (var j = 0; j < f.length; j++) out.push(f[j]);
    }
    return out;
  }

  function injectOrUpdate() {
    var price = getThemePrice();
    if (!price) return;

    var existing = queryAllRoots('[data-onetime-price]');
    if (existing.length) {
      for (var i = 0; i < existing.length; i++) {
        if (existing[i].textContent !== price) existing[i].textContent = price; // idempotent
      }
      return;
    }

    var roots = getRoots();
    for (var r = 0; r < roots.length; r++) {
      var rootNode = roots[r].body ? roots[r].body : roots[r];
      if (!rootNode) continue;
      var walker = document.createTreeWalker(rootNode, NodeFilter.SHOW_TEXT, {
        acceptNode: function (n) {
          if (!n.nodeValue || n.nodeValue.indexOf(CONFIG.token) === -1) return NodeFilter.FILTER_REJECT;
          if (n.parentNode && SKIP[n.parentNode.nodeName]) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        }
      });
      var node = walker.nextNode();
      if (!node) continue;

      var idx = node.nodeValue.indexOf(CONFIG.token);
      var span = document.createElement('span');
      span.setAttribute('data-onetime-price', '');
      span.textContent = price;
      var frag = document.createDocumentFragment();
      var before = node.nodeValue.slice(0, idx);
      var after = node.nodeValue.slice(idx + CONFIG.token.length);
      if (before) frag.appendChild(document.createTextNode(before));
      frag.appendChild(span);
      if (after) frag.appendChild(document.createTextNode(after));
      node.parentNode.replaceChild(frag, node);
      log('injected into one-time label');
      return;
    }
    log('price found but token %%PRICE%% not in DOM yet — check the One-time title field.');
  }

  var timer = null;
  function schedule() { if (timer) clearTimeout(timer); timer = setTimeout(injectOrUpdate, CONFIG.debounceMs); }

  schedule();
  document.addEventListener('DOMContentLoaded', schedule);
  window.addEventListener('load', schedule);
  [250, 800, 1600, 3200].forEach(function (ms) { setTimeout(schedule, ms); });

  new MutationObserver(schedule).observe(document.documentElement, {
    childList: true, subtree: true, characterData: true
  });

  ['variant:change', 'variantChange', 'product:variant-change', 'on:variant:change', 'change']
    .forEach(function (ev) { document.addEventListener(ev, schedule, true); });
})();
</script>
