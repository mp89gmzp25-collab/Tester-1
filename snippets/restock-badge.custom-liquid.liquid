{%- comment -%}
  ============================================================================
  RESTOCK / VALIDITY BADGE  —  Custom Liquid version
  Dova Probiotics Oral Spray PDP
  ============================================================================

  HOW TO USE
  Theme editor → Product template → Add block/section → "Custom Liquid" →
  paste this whole file into the code box → Save. Drag it under the product
  title. Paste a second Custom Liquid block above the bundle selector to
  reuse it (safe to duplicate).

  TO EDIT COPY / COLORS
  Everything is in the "EDIT HERE" block just below. Change the values
  between the quotes. {count} in the heading is replaced by sellout_count.
  No schema — Custom Liquid blocks don't support one — so this is the only
  place you tune it.
  ============================================================================
{%- endcomment -%}

{%- liquid
  # ===== EDIT HERE =========================================================
  assign badge_label   = 'Restocked'
  assign show_icon     = true
  assign icon_style    = 'check'            # 'check' or 'box'
  assign sellout_count = 3
  assign heading       = 'Sold out {count}x — restocked by popular demand.'
  assign subtext       = 'Selling fast again — most people grab the 3-pack.'

  assign card_bg       = '#FFFFFF'
  assign pill_bg       = '#3FA34D'
  assign pill_text     = '#FFFFFF'
  assign heading_color = '#000000'
  assign subtext_color = '#6B7280'

  assign margin_top    = 10
  assign margin_bottom = 12
  # ===== END EDIT ==========================================================

  assign heading = heading | replace: '{count}', sellout_count
-%}

<style>
  .rb-badge {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: {{ card_bg }};
    border-radius: 16px;
    padding: 14px 16px;
    box-shadow: 0 2px 10px rgba(16, 24, 40, 0.08);
    font-family: inherit;
    margin-top: {{ margin_top }}px;
    margin-bottom: {{ margin_bottom }}px;
  }
  .rb-badge__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    background: {{ pill_bg }};
    color: {{ pill_text }};
    border-radius: 999px;
    padding: 5px 11px 5px 9px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .rb-badge__pill svg { width: 14px; height: 14px; display: block; flex: 0 0 auto; }
  .rb-badge__copy { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .rb-badge__heading {
    color: {{ heading_color }};
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }
  .rb-badge__subtext {
    color: {{ subtext_color }};
    font-size: 13px;
    font-weight: 400;
    line-height: 1.35;
    margin: 0;
  }
  @media (min-width: 750px) {
    .rb-badge { padding: 16px 18px; gap: 14px; }
    .rb-badge__heading { font-size: 16px; }
    .rb-badge__subtext { font-size: 14px; }
  }
</style>

<div class="rb-badge" role="group" aria-label="{{ badge_label | escape }}: {{ heading | strip_html | escape }}">
  <span class="rb-badge__pill">
    {%- if show_icon -%}
      {%- if icon_style == 'box' -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Restocked package">
          <path d="M21 8l-9-5-9 5 9 5 9-5z"/>
          <path d="M3 8v8l9 5 9-5V8"/>
          <path d="M12 13v8"/>
        </svg>
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
             stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Verified restock">
          <path d="M20 6L9 17l-5-5"/>
        </svg>
      {%- endif -%}
    {%- endif -%}
    <span>{{ badge_label | escape }}</span>
  </span>

  <div class="rb-badge__copy">
    <p class="rb-badge__heading">{{ heading }}</p>
    {%- if subtext != blank -%}
      <p class="rb-badge__subtext">{{ subtext }}</p>
    {%- endif -%}
  </div>
</div>
