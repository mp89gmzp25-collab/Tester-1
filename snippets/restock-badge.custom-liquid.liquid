{%- comment -%}
  ============================================================================
  RESTOCK / VALIDITY BADGE  —  Custom Liquid (strict, no section/schema)
  Dova Probiotics Oral Spray PDP · Navidium theme
  ============================================================================

  HOW TO USE
  Theme editor → Product template → Add block → "Custom Liquid" → paste
  this whole file into the code box → Save. Place it directly UNDER the
  emoji-benefit bullets and ABOVE the "Unlock Bigger Savings" header.
  Safe to paste a second copy elsewhere (styles are class-scoped).

  TO EDIT COPY / NUMBERS / COLORS
  Everything lives in the EDIT HERE block just below — change the values
  between the quotes. Tokens are swapped in at render:
    {count}   → sellout_count   (bold line)
    {n}       → buyers_count     (activity line)
    {stock}   → stock_count      (low-stock line)
    {flavour} → flavour_name     (low-stock line)
  Set any text line to '' (empty) to hide it. Icon: 'check' or 'box'.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign badge_label   = 'Restocked'
  assign show_icon     = true
  assign icon_style    = 'check'

  assign sellout_count = 3
  assign heading       = 'Sold out {count}x — restocked by popular demand.'

  assign buyers_count  = 47
  assign activity_line = '{n} bought in the last 24 hours.'

  assign stock_count   = 12
  assign flavour_name  = 'Arctic Mint'
  assign lowstock_line = 'Only {stock} left in {flavour} — restocking soon.'

  assign pill_bg       = '#3FA34D'
  assign pill_text     = '#FFFFFF'
  assign heading_color = '#000000'
  assign subtext_color = '#6B7280'

  assign margin_top    = 12
  assign margin_bottom = 12

  assign heading  = heading       | replace: '{count}', sellout_count
  assign activity = activity_line | replace: '{n}', buyers_count
  assign lowstock = lowstock_line | replace: '{stock}', stock_count | replace: '{flavour}', flavour_name
-%}

<style>
  .rb-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    background: transparent;
    font-family: inherit;
    margin: {{ margin_top }}px 0 {{ margin_bottom }}px;
  }
  .rb-badge__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: {{ pill_bg }};
    color: {{ pill_text }};
    border-radius: 999px;
    padding: 5px 11px 5px 9px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .rb-badge__pill svg { width: 14px; height: 14px; display: block; flex: 0 0 auto; }
  .rb-badge__lines { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .rb-badge__heading {
    color: {{ heading_color }};
    font-size: 15px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }
  .rb-badge__sub {
    color: {{ subtext_color }};
    font-size: 13px;
    font-weight: 400;
    line-height: 1.25;
    margin: 0;
  }
  @media (min-width: 750px) {
    .rb-badge__heading { font-size: 16px; }
    .rb-badge__sub { font-size: 14px; }
  }
</style>

<div class="rb-badge" role="group" aria-label="{{ badge_label | escape }}: {{ heading | strip_html | escape }}">
  <span class="rb-badge__pill">
    {%- if show_icon -%}
      {%- if icon_style == 'box' -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Restocked package">
          <path d="M21 8l-9-5-9 5 9 5 9-5z"/>
          <path d="M3 8v8l9 5 9-5V8"/>
          <path d="M12 13v8"/>
        </svg>
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
             stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Verified restock">
          <path d="M20 6L9 17l-5-5"/>
        </svg>
      {%- endif -%}
    {%- endif -%}
    <span>{{ badge_label | escape }}</span>
  </span>

  <div class="rb-badge__lines">
    <p class="rb-badge__heading">{{ heading }}</p>
    {%- if activity != blank -%}<p class="rb-badge__sub">{{ activity }}</p>{%- endif -%}
    {%- if lowstock != blank -%}<p class="rb-badge__sub">{{ lowstock }}</p>{%- endif -%}
  </div>
</div>
