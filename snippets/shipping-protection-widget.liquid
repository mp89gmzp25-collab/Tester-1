{%- comment -%}
  ============================================================================
  DOVA DELIVERY PROTECTION — custom cart-drawer widget
  Leverages the existing tiered protection product (ex-Navidium).
  Shopify · Navidium theme
  ============================================================================

  ⚠️ COMPLIANCE: default-ON (pre-checked) paid add-ons are unlawful in the
  UK/EU. You are on the GBP market. Set DEFAULT_ON = false unless you have
  legal sign-off to pre-check it.

  USES YOUR EXISTING PRODUCT
  SP_HANDLE below points at "Dova Delivery Protection". Its many variants are
  price tiers (0.75, 1.5, 2.25, …). The widget reads ALL variants, then picks
  the tier for the current cart and adds/swaps it via the AJAX cart API —
  mimicking what the app did.

  >>> SET YOUR TIER RULE <<<
  I don't have the app's old bracket table, so tiering defaults to
  RATE % of the cart subtotal, clamped to the product's min/max variant and
  snapped to the nearest available variant. Set RATE (and MIN/MAX if wanted)
  to match your old pricing. Send me the exact brackets and I'll hard-map them.

  CONFIRM THE HANDLE
  SP_HANDLE must equal the product's URL handle (Product page → bottom → "Edit
  website SEO" → handle). If it's not 'dova-delivery-protection', change it.

  WHERE TO PASTE
  1) Edit code → Snippets → add snippet 'shipping-protection-widget' → paste.
  2) layout/theme.liquid, before </body>:  {% render 'shipping-protection-widget' %}
  It self-mounts into the cart drawer and re-mounts on re-render.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign sp_handle = 'dova-delivery-protection'
  assign sp_product = all_products[sp_handle]
-%}

{%- if sp_product and sp_product.variants.size > 0 -%}
<script>
(function () {
  'use strict';

  var VARIANTS = [
    {%- for v in sp_product.variants -%}
      { id: {{ v.id }}, price: {{ v.price }}, text: {{ v.price | money | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ].filter(function (v) { return v.price > 0; }).sort(function (a, b) { return a.price - b.price; });

  var CONFIG = {
    DEFAULT_ON: true,          // ⚠️ set false for UK/EU compliance
    SHOW_PRICE: true,

    // Tier rule — tune to match your old app config.
    RATE: 0.05,                // fee = 5% of cart subtotal…
    MIN_CENTS: VARIANTS.length ? VARIANTS[0].price : 0,                 // …clamped to cheapest variant…
    MAX_CENTS: VARIANTS.length ? VARIANTS[VARIANTS.length - 1].price : 0, // …and priciest variant.

    TITLE: 'Dova Delivery Protection',
    SUBTITLE: 'from Damage, Loss & Theft',
    DESC: 'By deselecting Delivery Protection, we will not be liable for lost or stolen packages.',
    ON_COLOR: '#111827',

    mountBeforeSelectors: [
      'cart-drawer [name="checkout"]',
      '.drawer__footer', '.cart-drawer__footer', '.cart__footer',
      '[name="checkout"]'
    ],
    optOutKey: 'dova_sp_optout',
    debug: false,
    debounceMs: 120
  };

  if (!VARIANTS.length) return;

  var VARIANT_IDS = {};
  VARIANTS.forEach(function (v) { VARIANT_IDS[v.id] = v; });

  var ROOT = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
  function api(p) { return ROOT.replace(/\/$/, '') + p; }
  function log() { if (CONFIG.debug && window.console) console.log.apply(console, ['[sp]'].concat([].slice.call(arguments))); }
  function optedOut() { try { return sessionStorage.getItem(CONFIG.optOutKey) === '1'; } catch (e) { return false; } }
  function setOptOut(v) { try { v ? sessionStorage.setItem(CONFIG.optOutKey, '1') : sessionStorage.removeItem(CONFIG.optOutKey); } catch (e) {} }

  var busy = false;

  function getCart() { return fetch(api('/cart.js'), { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.json(); }); }

  function protectionLine(cart) {
    for (var i = 0; i < cart.items.length; i++) if (VARIANT_IDS[cart.items[i].variant_id]) return cart.items[i];
    return null;
  }
  // Cart subtotal EXCLUDING any protection line, in cents (presentment currency).
  function othersSubtotal(cart) {
    var sum = 0;
    for (var i = 0; i < cart.items.length; i++) if (!VARIANT_IDS[cart.items[i].variant_id]) sum += cart.items[i].final_line_price;
    return sum;
  }
  function othersCount(cart) {
    var n = 0;
    for (var i = 0; i < cart.items.length; i++) if (!VARIANT_IDS[cart.items[i].variant_id]) n += cart.items[i].quantity;
    return n;
  }

  // Pick the variant whose price is nearest the desired fee for this cart.
  function pickVariant(subtotalCents) {
    var target = Math.max(CONFIG.MIN_CENTS, Math.min(CONFIG.MAX_CENTS, Math.round(subtotalCents * CONFIG.RATE)));
    var best = VARIANTS[0], bestD = Infinity;
    for (var i = 0; i < VARIANTS.length; i++) {
      var d = Math.abs(VARIANTS[i].price - target);
      if (d < bestD) { bestD = d; best = VARIANTS[i]; }
    }
    return best;
  }

  function addVariant(id) {
    return fetch(api('/cart/add.js'), {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: id, quantity: 1, properties: { _protection: 'true' } }] })
    });
  }
  function removeLine(key) {
    return fetch(api('/cart/change.js'), {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: key, quantity: 0 })
    });
  }
  function announceRefresh() {
    ['cart:refresh', 'cart:updated', 'cart:build', 'ajaxCart:updated'].forEach(function (ev) {
      try { document.dispatchEvent(new CustomEvent(ev, { bubbles: true })); } catch (e) {}
    });
  }

  // ---- UI -------------------------------------------------------------------
  function ensureStyles() {
    if (document.getElementById('sp-styles')) return;
    var css =
      '.sp-widget{display:flex;align-items:flex-start;gap:12px;font-family:inherit;padding:12px 0;}' +
      '.sp-icon{flex:0 0 auto;width:38px;height:38px;color:' + CONFIG.ON_COLOR + ';}' +
      '.sp-icon svg{width:100%;height:100%;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}' +
      '.sp-body{flex:1 1 auto;min-width:0;}' +
      '.sp-title{font-weight:700;font-size:15px;color:#111827;margin:0;}' +
      '.sp-sub{font-size:13px;color:#6B7280;margin:2px 0 0;}' +
      '.sp-desc{font-size:12px;color:#9CA3AF;margin:6px 0 0;line-height:1.35;}' +
      '.sp-switch{position:relative;width:44px;height:26px;flex:0 0 auto;display:inline-block;margin-top:2px;}' +
      '.sp-switch input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer;}' +
      '.sp-track{position:absolute;inset:0;background:#D1D5DB;border-radius:999px;transition:background .2s;pointer-events:none;}' +
      '.sp-track::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;background:#fff;border-radius:50%;transition:transform .2s;box-shadow:0 1px 2px rgba(0,0,0,.25);}' +
      '.sp-switch input:checked ~ .sp-track{background:' + CONFIG.ON_COLOR + ';}' +
      '.sp-switch input:checked ~ .sp-track::after{transform:translateX(18px);}' +
      '.sp-switch input:focus-visible ~ .sp-track{outline:2px solid #111827;outline-offset:2px;}' +
      '.sp-widget[data-busy="1"]{opacity:.6;pointer-events:none;}';
    var s = document.createElement('style'); s.id = 'sp-styles'; s.textContent = css;
    document.head.appendChild(s);
  }

  function buildWidget(checked, priceText) {
    var priceHtml = CONFIG.SHOW_PRICE && priceText ? ' · ' + priceText : '';
    var el = document.createElement('div');
    el.className = 'sp-widget';
    el.setAttribute('data-sp-widget', '');
    el.innerHTML =
      '<span class="sp-icon" aria-hidden="true">' +
        '<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.4-2.9 7.9-7 9-4.1-1.1-7-4.6-7-9V6l7-3z"/><path d="M9.2 12.2l2 2 3.6-3.8"/></svg>' +
      '</span>' +
      '<div class="sp-body">' +
        '<p class="sp-title">' + CONFIG.TITLE + '</p>' +
        '<p class="sp-sub" data-sp-sub>' + CONFIG.SUBTITLE + priceHtml + '</p>' +
        '<p class="sp-desc">' + CONFIG.DESC + '</p>' +
      '</div>' +
      '<label class="sp-switch">' +
        '<input type="checkbox" role="switch"' + (checked ? ' checked' : '') + ' aria-label="' + CONFIG.TITLE + '">' +
        '<span class="sp-track"></span>' +
      '</label>';
    el.querySelector('input').addEventListener('change', onToggle);
    return el;
  }

  function findMount() {
    for (var i = 0; i < CONFIG.mountBeforeSelectors.length; i++) {
      var t = document.querySelector(CONFIG.mountBeforeSelectors[i]);
      if (t) return t;
    }
    return null;
  }
  function setBusy(state) {
    busy = state;
    var w = document.querySelector('[data-sp-widget]');
    if (w) { w.setAttribute('data-busy', state ? '1' : '0'); var inp = w.querySelector('input'); if (inp) inp.disabled = state; }
  }

  function onToggle(e) {
    if (busy) { e.target.checked = !e.target.checked; return; }
    var want = e.target.checked;
    setBusy(true);
    getCart().then(function (cart) {
      if (want) { setOptOut(false); return addVariant(pickVariant(othersSubtotal(cart)).id); }
      setOptOut(true);
      var line = protectionLine(cart);
      return line ? removeLine(line.key) : null;
    }).then(function () { announceRefresh(); return sync(true); })
      .catch(function (err) { log('toggle error', err); })
      .then(function () { setBusy(false); });
  }

  function sync(afterMutation) {
    return getCart().then(function (cart) {
      var line = protectionLine(cart);
      var others = othersCount(cart);
      var existing = document.querySelector('[data-sp-widget]');

      // No real products → strip protection + hide.
      if (others === 0) {
        if (line && !busy) { setBusy(true); removeLine(line.key).then(function () { announceRefresh(); setBusy(false); }); }
        if (existing) existing.remove();
        return;
      }

      var want = pickVariant(othersSubtotal(cart));

      // Tier drift: protection present but wrong variant → swap to correct tier.
      if (line && line.variant_id !== want.id && !busy) {
        setBusy(true);
        return removeLine(line.key).then(function () { return addVariant(want.id); })
          .then(function () { announceRefresh(); setBusy(false); return sync(true); });
      }

      // Auto-check on first sight (compliance-sensitive).
      if (!afterMutation && CONFIG.DEFAULT_ON && !line && !optedOut() && !busy) {
        setBusy(true);
        return addVariant(want.id).then(function () { announceRefresh(); setBusy(false); return sync(true); });
      }

      var present = !!line;
      var priceText = present && VARIANT_IDS[line.variant_id] ? VARIANT_IDS[line.variant_id].text : want.text;

      var mount = findMount();
      if (!existing) {
        if (!mount) { log('no mount point yet'); return; }
        ensureStyles();
        mount.parentNode.insertBefore(buildWidget(present, priceText), mount);
      } else {
        var inp = existing.querySelector('input');
        if (inp && inp.checked !== present) inp.checked = present;
        var sub = existing.querySelector('[data-sp-sub]');
        if (sub) sub.textContent = CONFIG.SUBTITLE + (CONFIG.SHOW_PRICE && priceText ? ' · ' + priceText : '');
      }
    }).catch(function (err) { log('sync error', err); });
  }

  var timer = null;
  function schedule() { if (timer) clearTimeout(timer); timer = setTimeout(function () { sync(false); }, CONFIG.debounceMs); }

  schedule();
  document.addEventListener('DOMContentLoaded', schedule);
  window.addEventListener('load', schedule);
  new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true });
  ['cart:refresh', 'cart:updated', 'cart:build', 'ajaxCart:updated'].forEach(function (ev) { document.addEventListener(ev, schedule); });
})();
</script>
{%- else -%}
  {%- comment -%} 'dova-delivery-protection' not found — confirm SP_HANDLE. {%- endcomment -%}
{%- endif -%}
