{%- comment -%}
  ============================================================================
  RESTOCK / VALIDITY BADGE  —  Dova Probiotics Oral Spray PDP
  ============================================================================

  WHERE TO PLACE IT
  Theme editor → Product template → "Add section" → "Restock badge".
  Drop it directly UNDER the emoji-benefit bullets and ABOVE the
  "Unlock Bigger Savings" header. Borderless — it sits inline, no card.

  WHICH SETTING MAPS TO WHICH LINE
  ┌────────────────────────┬──────────────────────────────────────────────┐
  │ Setting                │ Controls                                       │
  ├────────────────────────┼──────────────────────────────────────────────┤
  │ Badge label            │ Text in the green pill ("Restocked")           │
  │ Show icon / Icon style │ The ✓ (or box) glyph inside the pill           │
  │ Sell-out count         │ Number for {count} in the bold line            │
  │ Heading (bold, black)  │ Line 2. Use {count} for the sell-out number    │
  │ Buyers count           │ Number for {n} in the activity line            │
  │ Activity line (grey)   │ Line 3. Use {n} for the buyers number          │
  │ Stock count            │ Number for {stock} in the low-stock line       │
  │ Flavour name           │ Text for {flavour} in the low-stock line       │
  │ Low-stock line (grey)  │ Line 4. Use {stock} and {flavour} as tokens    │
  │ Colors / Spacing       │ Pill + text colors, top/bottom spacing         │
  └────────────────────────┴──────────────────────────────────────────────┘

  Tokens ({count}, {n}, {stock}, {flavour}) are swapped in at render, so
  you only ever edit each number/name in its own field.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign heading  = s.heading       | replace: '{count}', s.sellout_count
  assign activity = s.activity_line | replace: '{n}', s.buyers_count
  assign lowstock = s.lowstock_line | replace: '{stock}', s.stock_count | replace: '{flavour}', s.flavour_name
-%}

{%- style -%}
  #restock-badge-{{ section.id }} .rb-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    /* borderless: no card background, border, or shadow */
    background: transparent;
    font-family: inherit;
    margin: {{ s.margin_top }}px 0 {{ s.margin_bottom }}px;
  }

  #restock-badge-{{ section.id }} .rb-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: {{ s.pill_bg }};
    color: {{ s.pill_text }};
    border-radius: 999px;
    padding: 5px 11px 5px 9px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  #restock-badge-{{ section.id }} .rb-pill svg {
    width: 14px;
    height: 14px;
    display: block;
    flex: 0 0 auto;
  }

  #restock-badge-{{ section.id }} .rb-lines {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  #restock-badge-{{ section.id }} .rb-heading {
    color: {{ s.heading_color }};
    font-size: 15px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }

  #restock-badge-{{ section.id }} .rb-sub {
    color: {{ s.subtext_color }};
    font-size: 13px;
    font-weight: 400;
    line-height: 1.25;
    margin: 0;
  }

  @media (min-width: 750px) {
    #restock-badge-{{ section.id }} .rb-heading { font-size: 16px; }
    #restock-badge-{{ section.id }} .rb-sub { font-size: 14px; }
  }
{%- endstyle -%}

<div id="restock-badge-{{ section.id }}">
  <div class="rb-badge" role="group" aria-label="{{ s.badge_label | escape }}: {{ heading | strip_html | escape }}">

    <span class="rb-pill">
      {%- if s.show_icon -%}
        {%- if s.icon_style == 'box' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
               stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Restocked package">
            <path d="M21 8l-9-5-9 5 9 5 9-5z"/>
            <path d="M3 8v8l9 5 9-5V8"/>
            <path d="M12 13v8"/>
          </svg>
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
               stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Verified restock">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
        {%- endif -%}
      {%- endif -%}
      <span>{{ s.badge_label | escape }}</span>
    </span>

    <div class="rb-lines">
      <p class="rb-heading">{{ heading }}</p>
      {%- if activity != blank -%}<p class="rb-sub">{{ activity }}</p>{%- endif -%}
      {%- if lowstock != blank -%}<p class="rb-sub">{{ lowstock }}</p>{%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Restock badge",
  "tag": "section",
  "class": "restock-badge-section",
  "settings": [
    { "type": "header", "content": "Badge pill" },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "info": "Text inside the green pill.",
      "default": "Restocked"
    },
    { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": true },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon style",
      "options": [
        { "value": "check", "label": "Checkmark" },
        { "value": "box", "label": "Box / package" }
      ],
      "default": "check"
    },

    { "type": "header", "content": "Line 2 — validity claim" },
    {
      "type": "number",
      "id": "sellout_count",
      "label": "Sell-out count",
      "info": "Replaces {count} in the heading.",
      "default": 3
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (bold, black)",
      "info": "Use {count} as the sell-out number token.",
      "default": "Sold out {count}x — restocked by popular demand."
    },

    { "type": "header", "content": "Line 3 — live activity" },
    {
      "type": "number",
      "id": "buyers_count",
      "label": "Buyers count",
      "info": "Replaces {n} in the activity line.",
      "default": 47
    },
    {
      "type": "text",
      "id": "activity_line",
      "label": "Activity line (grey)",
      "info": "Use {n} as the buyers number token. Leave blank to hide.",
      "default": "{n} bought in the last 24 hours."
    },

    { "type": "header", "content": "Line 4 — low stock" },
    {
      "type": "number",
      "id": "stock_count",
      "label": "Stock count",
      "info": "Replaces {stock} in the low-stock line.",
      "default": 12
    },
    {
      "type": "text",
      "id": "flavour_name",
      "label": "Flavour name",
      "info": "Replaces {flavour} in the low-stock line.",
      "default": "Arctic Mint"
    },
    {
      "type": "text",
      "id": "lowstock_line",
      "label": "Low-stock line (grey)",
      "info": "Use {stock} and {flavour} as tokens. Leave blank to hide.",
      "default": "Only {stock} left in {flavour} — restocking soon."
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "pill_bg", "label": "Pill background", "default": "#3FA34D" },
    { "type": "color", "id": "pill_text", "label": "Pill text / icon", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading text", "default": "#000000" },
    { "type": "color", "id": "subtext_color", "label": "Grey subtext", "default": "#6B7280" },

    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top spacing",
      "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom spacing",
      "info": "Keep small so it sequences into 'Unlock Bigger Savings'.",
      "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12
    }
  ],
  "presets": [ { "name": "Restock badge" } ]
}
{% endschema %}
