{%- comment -%}
  ============================================================================
  RESTOCK / VALIDITY BADGE  —  Dova Probiotics Oral Spray PDP
  ============================================================================

  WHAT IT IS
  A social-proof badge that signals the product sells out and gets restocked
  by demand. Answers the buyer's "is it legit?" gut-check and adds light,
  honest urgency. No fake timers.

  WHERE TO PLACE IT
  Theme editor → your Product template → "Add section" → "Restock badge".
  Drag it directly UNDER the product title. You can add a second copy above
  the bundle / pack selector if you want the reinforcement.

  WHICH SETTING MAPS TO WHICH LINE
  ┌────────────────────────┬──────────────────────────────────────────────┐
  │ Setting                │ Controls                                       │
  ├────────────────────────┼──────────────────────────────────────────────┤
  │ Badge label            │ Text inside the green pill ("Restocked")       │
  │ Show icon              │ Toggles the checkmark/box glyph in the pill    │
  │ Icon style             │ check  ▸ ✓   |   box ▸ 📦-style box glyph      │
  │ Sell-out count         │ The number injected where {count} appears      │
  │ Heading (bold, black)  │ Primary validity line. Use {count} as a token  │
  │                        │   e.g. "Sold out {count}x — restocked by ..."  │
  │ Subtext (grey, small)  │ Secondary light-urgency / stock-up nudge       │
  ├────────────────────────┼──────────────────────────────────────────────┤
  │ Colors (Card / Pill /  │ All brand colors are editable so you can tune  │
  │  Heading / Subtext)    │   without touching code.                       │
  └────────────────────────┴──────────────────────────────────────────────┘

  Copy tip: keep {count} in the Heading — the Sell-out count number is
  substituted in at render so you only edit the number in one place.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign heading = s.heading | replace: '{count}', s.sellout_count
-%}

{%- style -%}
  #restock-badge-{{ section.id }} {
    --rb-card-bg: {{ s.card_bg }};
    --rb-pill-bg: {{ s.pill_bg }};
    --rb-pill-text: {{ s.pill_text }};
    --rb-heading: {{ s.heading_color }};
    --rb-subtext: {{ s.subtext_color }};
    --rb-radius: 16px;
  }

  #restock-badge-{{ section.id }} .rb-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--rb-card-bg);
    border-radius: var(--rb-radius);
    padding: 14px 16px;
    box-shadow: 0 2px 10px rgba(16, 24, 40, 0.08);
    /* inherit the theme font stack — no third-party fonts */
    font-family: inherit;
    margin-top: {{ s.margin_top }}px;
    margin-bottom: {{ s.margin_bottom }}px;
  }

  #restock-badge-{{ section.id }} .rb-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    background: var(--rb-pill-bg);
    color: var(--rb-pill-text);
    border-radius: 999px;
    padding: 5px 11px 5px 9px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  #restock-badge-{{ section.id }} .rb-pill svg {
    width: 14px;
    height: 14px;
    display: block;
    flex: 0 0 auto;
  }

  #restock-badge-{{ section.id }} .rb-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  #restock-badge-{{ section.id }} .rb-heading {
    color: var(--rb-heading);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  #restock-badge-{{ section.id }} .rb-subtext {
    color: var(--rb-subtext);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.35;
    margin: 0;
  }

  /* Scale up gently on larger viewports; mobile-first defaults above. */
  @media (min-width: 750px) {
    #restock-badge-{{ section.id }} .rb-card { padding: 16px 18px; gap: 14px; }
    #restock-badge-{{ section.id }} .rb-heading { font-size: 16px; }
    #restock-badge-{{ section.id }} .rb-subtext { font-size: 14px; }
  }
{%- endstyle -%}

<div id="restock-badge-{{ section.id }}" class="rb-section">
  <div class="rb-card" role="group" aria-label="{{ s.badge_label | escape }}: {{ heading | strip_html | escape }}">

    <span class="rb-pill">
      {%- if s.show_icon -%}
        {%- if s.icon_style == 'box' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
               stroke-linecap="round" stroke-linejoin="round" role="img"
               aria-label="Restocked package">
            <path d="M21 8l-9-5-9 5 9 5 9-5z"/>
            <path d="M3 8v8l9 5 9-5V8"/>
            <path d="M12 13v8"/>
          </svg>
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
               stroke-linecap="round" stroke-linejoin="round" role="img"
               aria-label="Verified restock">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
        {%- endif -%}
      {%- endif -%}
      <span>{{ s.badge_label | escape }}</span>
    </span>

    <div class="rb-copy">
      <p class="rb-heading">{{ heading }}</p>
      {%- if s.subtext != blank -%}
        <p class="rb-subtext">{{ s.subtext }}</p>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Restock badge",
  "tag": "section",
  "class": "restock-badge-section",
  "settings": [
    {
      "type": "header",
      "content": "Badge pill"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "info": "Text inside the green pill.",
      "default": "Restocked"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon style",
      "options": [
        { "value": "check", "label": "Checkmark" },
        { "value": "box", "label": "Box / package" }
      ],
      "default": "check"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "number",
      "id": "sellout_count",
      "label": "Sell-out count",
      "info": "The number of times it sold out. Injected wherever {count} appears in the heading.",
      "default": 3
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (bold, black)",
      "info": "Primary validity line. Use {count} as a placeholder for the sell-out count.",
      "default": "Sold out {count}x — restocked by popular demand."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext (grey, smaller)",
      "info": "Secondary light-urgency / stock-up nudge.",
      "default": "Selling fast again — most people grab the 3-pack."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "Pill background",
      "default": "#3FA34D"
    },
    {
      "type": "color",
      "id": "pill_text",
      "label": "Pill text / icon",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext",
      "default": "#6B7280"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Restock badge"
    }
  ]
}
{% endschema %}
