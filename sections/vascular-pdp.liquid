{%- comment -%}
  ============================================================================
  VASCULAR PDP — Dova Nattokinase (below-hero body)
  ----------------------------------------------------------------------------
  Reusable section. Every image and every line of copy is editable in the
  theme editor. Hero / buy box / Kaching widget are OUT of scope (handled by
  the existing product section + the app). See README-vascular-pdp.md.

  ⚠️ All product values are PROVISIONAL schema defaults. Nothing ships until
  confirmed against the COA / spec sheet / finished label. See
  CLAIMS-TO-SUBSTANTIATE.md.

  Bands (each toggled by a show_* checkbox in Settings):
    5.1 trust bar · 5.2 good numbers cold hands · 5.3 build & clear ·
    5.4 dose gate · 5.5 comparison · 5.6 discovery · 5.7 ingredient grid ·
    5.8 what to expect · 5.9 who should skip · 5.10 reviews · 5.11 FAQ ·
    5.12 guarantee + CTA · disclaimer
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign mono_open = '<span class="vp-mono">'
  assign mono_close = '</span>'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .vp-root {
    --vp-paper: {{ s.color_paper }};
    --vp-paper-alt: {{ s.color_paper_alt }};
    --vp-ink: {{ s.color_ink }};
    --vp-red: {{ s.color_accent }};
    --vp-grey-1: {{ s.color_grey_1 }};
    --vp-grey-2: {{ s.color_grey_2 }};
    --vp-maxw: 44rem;
    --vp-wide: 60rem;
    --vp-mono: ui-monospace, "SFMono-Regular", "SF Mono", "Roboto Mono", Menlo, Consolas, monospace;

    background: var(--vp-paper);
    color: var(--vp-ink);
    font-family: var(--font-body-family, system-ui, sans-serif);
  }
  #shopify-section-{{ section.id }} .vp-root * { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .vp-band { padding: 40px 20px; }
  #shopify-section-{{ section.id }} .vp-band--alt { background: var(--vp-paper-alt); }
  #shopify-section-{{ section.id }} .vp-inner { max-width: var(--vp-maxw); margin: 0 auto; }
  #shopify-section-{{ section.id }} .vp-inner--wide { max-width: var(--vp-wide); }

  #shopify-section-{{ section.id }} .vp-h {
    font-family: var(--font-heading-family, Georgia, serif);
    font-weight: 700;
    font-size: clamp(1.6rem, 5.5vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 0.6em;
    color: var(--vp-ink);
  }
  #shopify-section-{{ section.id }} .vp-copy { font-size: 1.0625rem; line-height: 1.65; color: var(--vp-ink); }
  #shopify-section-{{ section.id }} .vp-copy p { margin: 0 0 1em; }
  #shopify-section-{{ section.id }} .vp-copy p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .vp-muted { color: var(--vp-grey-1); }

  /* Mono utility face — ONLY on verifiable figures. The design signature. */
  #shopify-section-{{ section.id }} .vp-mono {
    font-family: var(--vp-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  #shopify-section-{{ section.id }} .vp-fu {
    font-family: var(--vp-mono);
    color: var(--vp-red);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .vp-img { display: block; width: 100%; height: auto; border-radius: 10px; }

  /* 5.1 trust bar */
  #shopify-section-{{ section.id }} .vp-trust {
    background: var(--vp-ink);
    color: var(--vp-paper);
    padding: 14px 20px;
  }
  #shopify-section-{{ section.id }} .vp-trust ul {
    list-style: none; margin: 0 auto; padding: 0; max-width: var(--vp-wide);
    display: flex; flex-wrap: wrap; gap: 8px 22px; justify-content: center;
    font-size: 0.9375rem;
  }
  #shopify-section-{{ section.id }} .vp-trust li { display: flex; align-items: center; gap: 7px; }
  #shopify-section-{{ section.id }} .vp-trust .vp-mono { color: var(--vp-red); font-weight: 700; }
  #shopify-section-{{ section.id }} .vp-trust svg { width: 15px; height: 15px; flex: 0 0 auto; stroke: currentColor; fill: none; stroke-width: 2; }

  /* 5.3 steps */
  #shopify-section-{{ section.id }} .vp-steps { list-style: none; margin: 0; padding: 0; counter-reset: vp; }
  #shopify-section-{{ section.id }} .vp-steps li {
    counter-increment: vp; position: relative; padding: 0 0 20px 52px; margin: 0;
  }
  #shopify-section-{{ section.id }} .vp-steps li::before {
    content: counter(vp); position: absolute; left: 0; top: 0;
    width: 34px; height: 34px; border-radius: 50%;
    background: transparent; border: 1.5px solid var(--vp-grey-2);
    color: var(--vp-red); font-family: var(--vp-mono); font-weight: 700;
    display: flex; align-items: center; justify-content: center; font-size: 0.95rem;
  }
  #shopify-section-{{ section.id }} .vp-steps li:last-child { padding-bottom: 0; }

  /* 5.4 dose scale */
  #shopify-section-{{ section.id }} .vp-scale { margin-top: 22px; }
  #shopify-section-{{ section.id }} .vp-scale__track {
    position: relative; height: 12px; border-radius: 999px; background: var(--vp-grey-2); margin: 34px 0 10px;
  }
  #shopify-section-{{ section.id }} .vp-scale__dova {
    position: absolute; right: 0; top: 0; height: 100%;
    border-radius: 999px; background: var(--vp-red);
  }
  #shopify-section-{{ section.id }} .vp-scale__line { position: absolute; top: -6px; bottom: -6px; width: 2px; background: var(--vp-red); }
  #shopify-section-{{ section.id }} .vp-scale__mark { position: absolute; top: -30px; transform: translateX(-50%); text-align: center; }
  #shopify-section-{{ section.id }} .vp-scale__mark span { font-family: var(--vp-mono); font-size: 0.8125rem; color: var(--vp-grey-1); white-space: nowrap; }
  #shopify-section-{{ section.id }} .vp-scale__mark--dova span { color: var(--vp-red); font-weight: 700; }
  #shopify-section-{{ section.id }} .vp-scale__mark::after { content: ""; position: absolute; left: 50%; bottom: -8px; width: 1px; height: 8px; background: var(--vp-grey-1); }

  /* 5.5 comparison → stacked cards */
  #shopify-section-{{ section.id }} .vp-cmp { display: grid; gap: 12px; margin-top: 8px; }
  #shopify-section-{{ section.id }} .vp-cmp__row {
    border: 1px solid var(--vp-grey-2); border-radius: 10px; background: #fff0; padding: 14px 16px;
  }
  #shopify-section-{{ section.id }} .vp-cmp__label { font-weight: 700; font-size: 0.95rem; margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .vp-cmp__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  #shopify-section-{{ section.id }} .vp-cmp__cell { font-size: 0.95rem; }
  #shopify-section-{{ section.id }} .vp-cmp__cell small { display: block; color: var(--vp-grey-1); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 3px; }
  #shopify-section-{{ section.id }} .vp-cmp__cell--dova { color: var(--vp-ink); font-weight: 600; }
  #shopify-section-{{ section.id }} .vp-cmp__cell--generic { color: var(--vp-grey-1); }

  /* 5.7 ingredient grid */
  #shopify-section-{{ section.id }} .vp-ing { display: grid; gap: 14px; grid-template-columns: 1fr; margin-top: 8px; }
  #shopify-section-{{ section.id }} .vp-ing__card { border: 1px solid var(--vp-grey-2); border-radius: 12px; padding: 16px; background: #ffffff55; }
  #shopify-section-{{ section.id }} .vp-ing__dose { font-family: var(--vp-mono); color: var(--vp-red); font-weight: 700; font-size: 1.05rem; }
  #shopify-section-{{ section.id }} .vp-ing__name { font-weight: 700; font-size: 1.05rem; margin: 2px 0 6px; }
  #shopify-section-{{ section.id }} .vp-ing__job { font-size: 0.9875rem; line-height: 1.55; color: var(--vp-ink); margin: 0; }
  #shopify-section-{{ section.id }} .vp-ing__img { width: 100%; height: auto; border-radius: 8px; margin-bottom: 10px; }
  #shopify-section-{{ section.id }} .vp-card {
    margin-top: 18px; border-left: 3px solid var(--vp-red); padding: 4px 0 4px 16px;
    font-size: 1.0625rem; line-height: 1.55;
  }

  /* 5.8 horizons */
  #shopify-section-{{ section.id }} .vp-horizon { border-top: 1px solid var(--vp-grey-2); padding: 16px 0; }
  #shopify-section-{{ section.id }} .vp-horizon:first-of-type { border-top: 0; }
  #shopify-section-{{ section.id }} .vp-horizon h3 { margin: 0 0 6px; font-size: 1rem; font-family: var(--vp-mono); color: var(--vp-red); letter-spacing: -0.01em; }

  /* 5.9 safety */
  #shopify-section-{{ section.id }} .vp-safety { background: #ffffff44; }
  #shopify-section-{{ section.id }} .vp-safety ul { padding-left: 1.1em; }
  #shopify-section-{{ section.id }} .vp-safety li { margin-bottom: 0.5em; }

  /* 5.10 reviews */
  #shopify-section-{{ section.id }} .vp-rev { display: grid; gap: 14px; margin-top: 8px; }
  #shopify-section-{{ section.id }} .vp-rev__card { border: 1px solid var(--vp-grey-2); border-radius: 12px; padding: 16px; }
  #shopify-section-{{ section.id }} .vp-rev__meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; font-size: 0.875rem; color: var(--vp-grey-1); margin-bottom: 6px; }
  #shopify-section-{{ section.id }} .vp-rev__verified { color: var(--vp-red); font-weight: 600; }
  #shopify-section-{{ section.id }} .vp-rev__stars { color: var(--vp-red); letter-spacing: 1px; }
  #shopify-section-{{ section.id }} .vp-rev__count { font-family: var(--vp-mono); }
  #shopify-section-{{ section.id }} .vp-rev__head { font-weight: 700; margin: 0 0 4px; }
  #shopify-section-{{ section.id }} .vp-rev__body { margin: 0; font-size: 0.9875rem; line-height: 1.55; }

  /* 5.11 faq */
  #shopify-section-{{ section.id }} .vp-faq details { border-bottom: 1px solid var(--vp-grey-2); }
  #shopify-section-{{ section.id }} .vp-faq summary {
    cursor: pointer; padding: 16px 30px 16px 0; position: relative; font-weight: 600; font-size: 1.0625rem; list-style: none;
  }
  #shopify-section-{{ section.id }} .vp-faq summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .vp-faq summary::after { content: "+"; position: absolute; right: 4px; top: 14px; font-family: var(--vp-mono); color: var(--vp-red); font-size: 1.3rem; }
  #shopify-section-{{ section.id }} .vp-faq details[open] summary::after { content: "\2013"; }
  #shopify-section-{{ section.id }} .vp-faq__a { padding: 0 0 16px; font-size: 1rem; line-height: 1.6; color: var(--vp-ink); }

  /* CTA */
  #shopify-section-{{ section.id }} .vp-cta {
    display: inline-block; background: var(--vp-red); color: var(--vp-paper);
    font-weight: 700; font-size: 1.0625rem; text-decoration: none;
    padding: 15px 30px; border-radius: 999px; border: 0; cursor: pointer;
  }
  #shopify-section-{{ section.id }} .vp-cta:hover { filter: brightness(0.94); }
  #shopify-section-{{ section.id }} .vp-cta-wrap { text-align: center; margin: 18px 0 10px; }
  #shopify-section-{{ section.id }} .vp-fineprint { font-size: 0.875rem; color: var(--vp-grey-1); text-align: center; line-height: 1.5; }
  #shopify-section-{{ section.id }} .vp-fineprint .vp-mono { color: var(--vp-grey-1); }
  #shopify-section-{{ section.id }} .vp-safelink { color: var(--vp-red); font-weight: 600; text-decoration: underline; }

  #shopify-section-{{ section.id }} .vp-disclaimer { font-size: 0.8125rem; color: var(--vp-grey-1); line-height: 1.5; }

  /* focus + a11y */
  #shopify-section-{{ section.id }} .vp-root a:focus-visible,
  #shopify-section-{{ section.id }} .vp-root summary:focus-visible,
  #shopify-section-{{ section.id }} .vp-root .vp-cta:focus-visible {
    outline: 3px solid var(--vp-red); outline-offset: 2px; border-radius: 4px;
  }

  /* desktop */
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .vp-band { padding: 64px 24px; }
    #shopify-section-{{ section.id }} .vp-ing { grid-template-columns: 1fr 1fr; }
    #shopify-section-{{ section.id }} .vp-rev { grid-template-columns: 1fr 1fr; }
    #shopify-section-{{ section.id }} .vp-split { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; }
  }

  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .vp-fade { opacity: 0; transform: translateY(10px); transition: opacity .5s ease, transform .5s ease; }
    #shopify-section-{{ section.id }} .vp-fade.vp-in { opacity: 1; transform: none; }
  }
{%- endstyle -%}

<div class="vp-root" id="vp-top">

  {%- comment -%} 5.1 TRUST BAR {%- endcomment -%}
  {%- if s.show_trustbar -%}
    <div class="vp-trust">
      <ul>
        {%- if s.trust_1 != blank -%}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{ s.trust_1 }}</li>{%- endif -%}
        {%- if s.trust_2 != blank -%}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{ s.trust_2 }}</li>{%- endif -%}
        {%- if s.trust_3 != blank -%}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{ s.trust_3 }}</li>{%- endif -%}
        {%- if s.trust_4 != blank -%}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{ s.trust_4 }}</li>{%- endif -%}
      </ul>
    </div>
  {%- endif -%}

  {%- comment -%} 5.2 GOOD NUMBERS. COLD HANDS. {%- endcomment -%}
  {%- if s.show_gap -%}
    <section class="vp-band">
      <div class="vp-inner vp-inner--wide">
        <div class="vp-split">
          <div>
            {%- if s.gap_heading != blank -%}<h2 class="vp-h">{{ s.gap_heading }}</h2>{%- endif -%}
            <div class="vp-copy">{{ s.gap_body }}</div>
          </div>
          {%- if s.gap_img != blank -%}
            <img class="vp-img" src="{{ s.gap_img | image_url: width: 1000 }}"
              srcset="{{ s.gap_img | image_url: width: 500 }} 500w, {{ s.gap_img | image_url: width: 1000 }} 1000w"
              sizes="(min-width: 750px) 50vw, 100vw"
              width="{{ s.gap_img.width }}" height="{{ s.gap_img.height }}"
              alt="{{ s.gap_img.alt | escape }}" loading="lazy" decoding="async">
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5.3 BUILD & CLEAR {%- endcomment -%}
  {%- if s.show_mechanism -%}
    <section class="vp-band">
      <div class="vp-inner">
        {%- if s.mech_heading != blank -%}<h2 class="vp-h">{{ s.mech_heading }}</h2>{%- endif -%}
        <ol class="vp-steps vp-copy">
          {%- if s.mech_step_1 != blank -%}<li>{{ s.mech_step_1 }}</li>{%- endif -%}
          {%- if s.mech_step_2 != blank -%}<li>{{ s.mech_step_2 }}</li>{%- endif -%}
          {%- if s.mech_step_3 != blank -%}<li>{{ s.mech_step_3 }}</li>{%- endif -%}
          {%- if s.mech_step_4 != blank -%}<li>{{ s.mech_step_4 }}</li>{%- endif -%}
          {%- if s.mech_step_5 != blank -%}<li>{{ s.mech_step_5 }}</li>{%- endif -%}
        </ol>
        {%- if s.mech_close != blank -%}<div class="vp-copy vp-card">{{ s.mech_close }}</div>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5.4 DOSE GATE {%- endcomment -%}
  {%- if s.show_dosegate -%}
    <section class="vp-band vp-band--alt" id="vp-dose">
      <div class="vp-inner">
        {%- if s.dose_heading != blank -%}<h2 class="vp-h">{{ s.dose_heading }}</h2>{%- endif -%}
        <div class="vp-copy">{{ s.dose_body }}</div>

        {%- if s.dose_scale_show -%}
          <div class="vp-scale vp-fade" aria-hidden="true">
            <div class="vp-scale__track">
              <div class="vp-scale__dova" style="left:{{ s.dose_threshold_pos }}%"></div>
              <div class="vp-scale__line" style="left:{{ s.dose_threshold_pos }}%"></div>
              {%- if s.dose_tier_1 != blank -%}<div class="vp-scale__mark" style="left:{{ s.dose_tier_1_pos }}%"><span>{{ s.dose_tier_1 }}</span></div>{%- endif -%}
              {%- if s.dose_tier_2 != blank -%}<div class="vp-scale__mark" style="left:{{ s.dose_tier_2_pos }}%"><span>{{ s.dose_tier_2 }}</span></div>{%- endif -%}
              {%- if s.dose_tier_3 != blank -%}<div class="vp-scale__mark" style="left:{{ s.dose_tier_3_pos }}%"><span>{{ s.dose_tier_3 }}</span></div>{%- endif -%}
              {%- if s.dose_tier_dova != blank -%}<div class="vp-scale__mark vp-scale__mark--dova" style="left:{{ s.dose_threshold_pos | plus: 5 }}%"><span>{{ s.dose_tier_dova }}</span></div>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5.5 COMPARISON {%- endcomment -%}
  {%- if s.show_comparison -%}
    <section class="vp-band">
      <div class="vp-inner">
        {%- if s.cmp_heading != blank -%}<h2 class="vp-h">{{ s.cmp_heading }}</h2>{%- endif -%}
        <div class="vp-cmp">
          {%- for block in section.blocks -%}
            {%- if block.type == 'comparison_row' -%}
              <div class="vp-cmp__row" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}<p class="vp-cmp__label">{{ block.settings.label }}</p>{%- endif -%}
                <div class="vp-cmp__cols">
                  <div class="vp-cmp__cell vp-cmp__cell--generic"><small>{{ s.cmp_col_generic | default: 'Generic' }}</small>{{ block.settings.generic_value }}</div>
                  <div class="vp-cmp__cell vp-cmp__cell--dova"><small>{{ s.cmp_col_dova | default: 'Dova' }}</small>{{ block.settings.dova_value }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5.6 DISCOVERY {%- endcomment -%}
  {%- if s.show_discovery -%}
    <section class="vp-band">
      <div class="vp-inner vp-inner--wide">
        {%- if s.disc_heading != blank -%}<h2 class="vp-h">{{ s.disc_heading }}</h2>{%- endif -%}
        <div class="vp-split">
          <div class="vp-copy">{{ s.disc_body }}</div>
          <div>
            {%- if s.disc_img_a != blank -%}
              <img class="vp-img" style="margin-bottom:12px" src="{{ s.disc_img_a | image_url: width: 900 }}"
                srcset="{{ s.disc_img_a | image_url: width: 450 }} 450w, {{ s.disc_img_a | image_url: width: 900 }} 900w"
                sizes="(min-width: 750px) 50vw, 100vw" width="{{ s.disc_img_a.width }}" height="{{ s.disc_img_a.height }}"
                alt="{{ s.disc_img_a.alt | escape }}" loading="lazy" decoding="async">
            {%- endif -%}
            {%- if s.disc_img_b != blank -%}
              <img class="vp-img" src="{{ s.disc_img_b | image_url: width: 900 }}"
                srcset="{{ s.disc_img_b | image_url: width: 450 }} 450w, {{ s.disc_img_b | image_url: width: 900 }} 900w"
                sizes="(min-width: 750px) 50vw, 100vw" width="{{ s.disc_img_b.width }}" height="{{ s.disc_img_b.height }}"
                alt="{{ s.disc_img_b.alt | escape }}" loading="lazy" decoding="async">
            {%- endif -%}
          </div>
        </div>
        {%- if s.disc_quote != blank -%}
          <p class="vp-copy vp-card" style="margin-top:24px;font-size:1.15rem">{{ s.disc_quote }}</p>
        {%- endif -%}
        {%- if s.disc_after != blank -%}<div class="vp-copy" style="margin-top:16px">{{ s.disc_after }}</div>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5.7 INGREDIENT GRID {%- endcomment -%}
  {%- if s.show_ingredients -%}
    <section class="vp-band vp-band--alt">
      <div class="vp-inner vp-inner--wide">
        {%- if s.ing_heading != blank -%}<h2 class="vp-h">{{ s.ing_heading }}</h2>{%- endif -%}
        {%- if s.ing_intro != blank -%}<div class="vp-copy" style="margin-bottom:14px">{{ s.ing_intro }}</div>{%- endif -%}
        {%- if s.ing_directions != blank -%}<p class="vp-muted" style="margin:0 0 20px;font-size:0.95rem"><strong>How to take it:</strong> {{ s.ing_directions }}</p>{%- endif -%}
        <div class="vp-ing">
          {%- for block in section.blocks -%}
            {%- if block.type == 'ingredient' -%}
              <div class="vp-ing__card" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img class="vp-ing__img" src="{{ block.settings.image | image_url: width: 600 }}"
                    width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.image.alt | escape }}" loading="lazy" decoding="async">
                {%- endif -%}
                {%- if block.settings.dose != blank -%}<div class="vp-ing__dose">{{ block.settings.dose }}</div>{%- endif -%}
                {%- if block.settings.name != blank -%}<div class="vp-ing__name">{{ block.settings.name }}</div>{%- endif -%}
                {%- if block.settings.job != blank -%}<p class="vp-ing__job">{{ block.settings.job }}</p>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if s.ing_close != blank -%}<div class="vp-copy vp-card" style="margin-top:22px;font-size:1.15rem">{{ s.ing_close }}</div>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5.8 WHAT TO EXPECT {%- endcomment -%}
  {%- if s.show_expect -%}
    <section class="vp-band">
      <div class="vp-inner">
        {%- if s.exp_heading != blank -%}<h2 class="vp-h">{{ s.exp_heading }}</h2>{%- endif -%}
        {%- if s.exp_intro != blank -%}<div class="vp-copy" style="margin-bottom:8px">{{ s.exp_intro }}</div>{%- endif -%}
        {%- if s.exp_1 != blank -%}<div class="vp-horizon"><h3>{{ s.exp_1_label }}</h3><div class="vp-copy">{{ s.exp_1 }}</div></div>{%- endif -%}
        {%- if s.exp_2 != blank -%}<div class="vp-horizon"><h3>{{ s.exp_2_label }}</h3><div class="vp-copy">{{ s.exp_2 }}</div></div>{%- endif -%}
        {%- if s.exp_3 != blank -%}<div class="vp-horizon"><h3>{{ s.exp_3_label }}</h3><div class="vp-copy">{{ s.exp_3 }}</div></div>{%- endif -%}
        {%- if s.exp_close != blank -%}<div class="vp-copy vp-muted" style="margin-top:14px">{{ s.exp_close }}</div>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5.9 WHO SHOULD SKIP {%- endcomment -%}
  {%- if s.show_safety -%}
    <section class="vp-band vp-safety" id="vp-safety">
      <div class="vp-inner">
        {%- if s.safety_heading != blank -%}<h2 class="vp-h">{{ s.safety_heading }}</h2>{%- endif -%}
        <div class="vp-copy">{{ s.safety_body }}</div>
        {%- if s.safety_plaque != blank -%}<div class="vp-copy" style="margin-top:14px">{{ s.safety_plaque }}</div>{%- endif -%}
        {%- if s.safety_reframe != blank -%}<div class="vp-copy vp-card" style="margin-top:16px">{{ s.safety_reframe }}</div>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5.10 REVIEWS {%- endcomment -%}
  {%- if s.show_reviews -%}
    <section class="vp-band">
      <div class="vp-inner vp-inner--wide">
        {%- if s.rev_heading != blank -%}<h2 class="vp-h">{{ s.rev_heading }}</h2>{%- endif -%}
        <div class="vp-rev">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <div class="vp-rev__card" {{ block.shopify_attributes }}>
                <div class="vp-rev__meta">
                  {%- assign st = block.settings.stars | at_most: 5 | at_least: 0 -%}
                  <span class="vp-rev__stars" aria-label="{{ st }} out of 5">{% for i in (1..st) %}&#9733;{% endfor %}</span>
                  {%- if block.settings.name != blank -%}<span>{{ block.settings.name }}{% if block.settings.age != blank %}, <span class="vp-rev__count">{{ block.settings.age }}</span>{% endif %}</span>{%- endif -%}
                  {%- if block.settings.verified -%}<span class="vp-rev__verified">Verified</span>{%- endif -%}
                </div>
                {%- if block.settings.headline != blank -%}<p class="vp-rev__head">{{ block.settings.headline }}</p>{%- endif -%}
                {%- if block.settings.body != blank -%}<p class="vp-rev__body">{{ block.settings.body }}</p>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5.11 FAQ {%- endcomment -%}
  {%- if s.show_faq -%}
    <section class="vp-band vp-band--alt">
      <div class="vp-inner">
        {%- if s.faq_heading != blank -%}<h2 class="vp-h">{{ s.faq_heading }}</h2>{%- endif -%}
        <div class="vp-faq">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              <details {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question }}</summary>
                <div class="vp-faq__a">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5.12 GUARANTEE + CTA {%- endcomment -%}
  {%- if s.show_guarantee -%}
    <section class="vp-band">
      <div class="vp-inner">
        {%- if s.gtee_heading != blank -%}<h2 class="vp-h" style="text-align:center">{{ s.gtee_heading }}</h2>{%- endif -%}
        {%- if s.gtee_body != blank -%}<div class="vp-copy" style="text-align:center">{{ s.gtee_body }}</div>{%- endif -%}
        <div class="vp-cta-wrap">
          <a href="#offer-block" class="vp-cta" data-bundle-index="{{ s.cta_bundle_index }}">{{ s.cta_label | default: 'See the bundles' }}</a>
        </div>
        {%- if s.gtee_fineprint != blank -%}<p class="vp-fineprint">{{ s.gtee_fineprint }}</p>{%- endif -%}
        <!-- TODO: shipping cost -->
        {%- if s.shipping_cost != blank -%}<p class="vp-fineprint" style="margin-top:6px">Shipping: {{ s.shipping_cost }}</p>{%- endif -%}
        {%- if s.contact_line != blank -%}<p class="vp-fineprint" style="margin-top:10px"><span class="vp-mono">{{ s.contact_line }}</span></p>{%- endif -%}
        {%- if s.disclaimer != blank -%}<div class="vp-disclaimer vp-inner" style="margin-top:26px">{{ s.disclaimer }}</div>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    var SEL_CONTAINER = {{ s.kaching_container | default: '.kaching-bundles__bar' | json }};
    var SEL_OPTION    = {{ s.kaching_option    | default: '.kaching-bundles__block' | json }};

    function target() {
      return document.querySelector('#offer-block')
          || document.querySelector(SEL_CONTAINER)
          || document.querySelector('product-form')
          || document.querySelector('form[action*="/cart/add"]');
    }

    root.querySelectorAll('.vp-cta').forEach(function (el) {
      el.addEventListener('click', function (e) {
        var t = target();
        if (!t) return;                     // let the href fall through — never a dead button
        e.preventDefault();
        t.scrollIntoView({ behavior: 'smooth', block: 'center' });
        var idx = el.dataset.bundleIndex;
        if (idx == null || idx === '') return;
        setTimeout(function () {
          var opts = document.querySelectorAll(SEL_OPTION);
          if (opts[idx]) opts[idx].click();  // preselect the tier; never calls /cart/add
        }, 450);
      });
    });

    // One quiet scroll-fade on the dose scale only (respects reduced-motion via CSS).
    var fades = root.querySelectorAll('.vp-fade');
    if (fades.length && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('vp-in'); io.unobserve(en.target); } });
      }, { threshold: 0.25 });
      fades.forEach(function (f) { io.observe(f); });
    } else {
      fades.forEach(function (f) { f.classList.add('vp-in'); });
    }
  })();
</script>

{% schema %}
{
  "name": "Vascular PDP",
  "tag": "section",
  "class": "vascular-pdp-section",
  "settings": [
    { "type": "header", "content": "Palette (verified-paperwork system)" },
    { "type": "color", "id": "color_paper", "label": "Paper background", "default": "#F2ECDE" },
    { "type": "color", "id": "color_paper_alt", "label": "Paper background — alt (brighter, 3 bands)", "default": "#FCFAF5" },
    { "type": "color", "id": "color_ink", "label": "Ink (near-black)", "default": "#17140F" },
    { "type": "color", "id": "color_accent", "label": "Accent — verifiable numbers + CTA only", "default": "#C0362C" },
    { "type": "color", "id": "color_grey_1", "label": "Structural grey (text)", "default": "#726B5E" },
    { "type": "color", "id": "color_grey_2", "label": "Structural grey (lines)", "default": "#CEC4AF" },

    { "type": "header", "content": "5.1 Trust bar" },
    { "type": "checkbox", "id": "show_trustbar", "label": "Show trust bar", "default": true },
    { "type": "text", "id": "trust_1", "label": "Item 1", "default": "Scan the batch, see the test" },
    { "type": "text", "id": "trust_2", "label": "Item 2", "default": "180-day money-back, keep the bottle" },
    { "type": "text", "id": "trust_3", "label": "Item 3", "default": "Tracked shipping" },
    { "type": "text", "id": "trust_4", "label": "Item 4", "default": "Ships same day" },

    { "type": "header", "content": "5.2 Good numbers. Cold hands." },
    { "type": "checkbox", "id": "show_gap", "label": "Show section", "default": true },
    { "type": "text", "id": "gap_heading", "label": "Heading", "default": "Good numbers. Cold hands." },
    { "type": "richtext", "id": "gap_body", "label": "Body", "default": "<p>Your last bloodwork came back fine. The doctor said keep doing what you're doing. And you still can't feel your feet by the evening, your hands go cold at your desk, and the stairs take something out of you they didn't used to.</p><p>A blood test is an inventory. It counts what's floating in your blood on the morning they draw it. It has never once measured how the blood moves — how easily it gets to your hands, your feet, the small vessels at the ends of you.</p><p>That's the gap. Good numbers on paper. Cold hands in the room. This page is about the second one.</p>" },
    { "type": "image_picker", "id": "gap_img", "label": "Image — person 55–70 at home with a lab printout (not clinical, not stock-smiley)" },

    { "type": "header", "content": "5.3 Build and clear (the mechanism)" },
    { "type": "checkbox", "id": "show_mechanism", "label": "Show section", "default": true },
    { "type": "text", "id": "mech_heading", "label": "Heading", "default": "Your body builds and clears all day. After fifty, one side slows down." },
    { "type": "inline_richtext", "id": "mech_step_1", "label": "Step 1", "default": "<strong>You build small repairs constantly.</strong> Every time a vessel takes a little wear, your body patches it. This is normal. It's supposed to happen." },
    { "type": "inline_richtext", "id": "mech_step_2", "label": "Step 2", "default": "<strong>Then a clearing system breaks those patches back down</strong> so the blood keeps moving freely. Build, clear, build, clear — all day, without you noticing." },
    { "type": "inline_richtext", "id": "mech_step_3", "label": "Step 3", "default": "<strong>After about fifty, the clearing side slows.</strong> The building side doesn't. [CITATION NEEDED — fibrinolytic decline with age]" },
    { "type": "inline_richtext", "id": "mech_step_4", "label": "Step 4", "default": "<strong>So you build like you're 25 and clear like you're 65.</strong> Same repairs going up. Fewer coming back down." },
    { "type": "inline_richtext", "id": "mech_step_5", "label": "Step 5 (the pivot)", "default": "<strong>Here's the part nobody mentions.</strong> Diet, exercise, and almost every bottle on the counter are aimed at building less. Almost nothing is aimed at clearing more. That's the side that slowed down." },
    { "type": "richtext", "id": "mech_close", "label": "Closing", "default": "<p>That's why this is a different conversation from your statin or your fish oil. Those work on the building side. This supports your body's normal fibrinolytic activity — the clearing side — so blood keeps moving the way it did when the clearing kept up. [CITATION NEEDED — nattokinase fibrinolytic mechanism]</p>" },

    { "type": "header", "content": "5.4 The dose gate" },
    { "type": "checkbox", "id": "show_dosegate", "label": "Show section", "default": true },
    { "type": "text", "id": "dose_heading", "label": "Heading", "default": "The dose is the whole argument." },
    { "type": "richtext", "id": "dose_body", "label": "Body", "default": "<p>FU stands for fibrinolytic units. It's not the weight of the capsule — it's how much clearing activity is actually in a serving. Two bottles can hold the same milligrams and deliver completely different FU. FU is the number that matters. Everything else on the label is packaging.</p><p>Here's the part the ads got right: below a real dose, the research doesn't apply to what you're holding. Most bottles sell at 2,000 to 5,000 FU per serving. That's not a smaller version of the same thing. It's under the line where the evidence lives.</p><p><strong>About that one study that found nothing.</strong> Someone has probably pointed you at a trial that ran for years, on a few hundred people, and found no effect. Read the method. That trial dosed at roughly 2,000 FU. It didn't test a real dose and come up empty. It tested a fifth of one.</p><p><strong>Why most brands sit under the line.</strong> FU is the expensive part. The cheapest way to sell nattokinase is to put a little in, print the milligrams, and stay quiet about the FU. 10,000 FU per serving is what it costs to be on the right side of the line.</p>" },
    { "type": "checkbox", "id": "dose_scale_show", "label": "Show dose scale visual", "default": true },
    { "type": "range", "id": "dose_threshold_pos", "label": "Scale — where the red qualifying zone begins (the 10,000 line)", "min": 55, "max": 95, "step": 1, "unit": "%", "default": 86 },
    { "type": "text", "id": "dose_tier_1", "label": "Scale — competitor tier 1 (sits in grey, under the line)", "default": "2,000 FU" },
    { "type": "range", "id": "dose_tier_1_pos", "label": "Tier 1 position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 16 },
    { "type": "text", "id": "dose_tier_2", "label": "Scale — competitor tier 2", "default": "4,000 FU" },
    { "type": "range", "id": "dose_tier_2_pos", "label": "Tier 2 position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 33 },
    { "type": "text", "id": "dose_tier_3", "label": "Scale — competitor tier 3", "default": "5,000 FU" },
    { "type": "range", "id": "dose_tier_3_pos", "label": "Tier 3 position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 42 },
    { "type": "text", "id": "dose_tier_dova", "label": "Scale — Dova (sits in the red zone)", "default": "Dova 10,000 FU" },

    { "type": "header", "content": "5.5 Comparison (add comparison rows as blocks)" },
    { "type": "checkbox", "id": "show_comparison", "label": "Show section", "default": true },
    { "type": "text", "id": "cmp_heading", "label": "Heading", "default": "Same word on the label. Different thing in the bottle." },
    { "type": "text", "id": "cmp_col_generic", "label": "Left column label", "default": "Generic nattokinase" },
    { "type": "text", "id": "cmp_col_dova", "label": "Right column label", "default": "Dova" },

    { "type": "header", "content": "5.6 The discovery story" },
    { "type": "checkbox", "id": "show_discovery", "label": "Show section", "default": true },
    { "type": "text", "id": "disc_heading", "label": "Heading", "default": "Nobody invented this in a lab." },
    { "type": "richtext", "id": "disc_body", "label": "Body", "default": "<p>The enzyme wasn't found by a company screening exotic compounds for something to sell. It was found in a food people in one part of Japan had been eating at breakfast, every day, for something like a thousand years. [CITATION NEEDED — nattokinase discovery attribution] A researcher looked at a traditional fermented food and asked what the sticky part was doing. The sticky part was the enzyme.</p><p>That's the honest version. Not a breakthrough. An old food, looked at closely.</p><p>Which leaves one problem, and if you've ever been near a bowl of it you already know what it is.</p>" },
    { "type": "image_picker", "id": "disc_img_a", "label": "Image A — lab / bench context" },
    { "type": "image_picker", "id": "disc_img_b", "label": "Image B — natto in cultural context (heritage, not product)" },
    { "type": "inline_richtext", "id": "disc_quote", "label": "Narration line (not a testimonial — no attribution)", "default": "The most common thing people say about it is some version of the same line: they would rather just take the pill." },
    { "type": "richtext", "id": "disc_after", "label": "After the quote", "default": "<p>You've already decided the food is good for you. You've also already decided you're not going to eat it. That's fine. That's the entire point of this product. It's the dose from the food, without the food.</p>" },

    { "type": "header", "content": "5.7 Ingredient grid (add ingredients as blocks)" },
    { "type": "checkbox", "id": "show_ingredients", "label": "Show section", "default": true },
    { "type": "text", "id": "ing_heading", "label": "Heading", "default": "Every dose is printed. Count it yourself." },
    { "type": "richtext", "id": "ing_intro", "label": "Intro", "default": "<p>No proprietary blends. No circulation matrix hiding three cents of active behind a trademark. Each thing in the bottle is named, dosed, and doing one job. If you can't find the number on the label, we didn't earn the sale.</p>" },
    { "type": "text", "id": "ing_directions", "label": "Directions line (near the grid)", "default": "2 capsules daily, with or without food. Evening preferred." },
    { "type": "richtext", "id": "ing_close", "label": "Closing card", "default": "<p>You don't need more bottles. You need the doses in the bottles you already own to be real.</p>" },

    { "type": "header", "content": "5.8 What to expect, and when" },
    { "type": "checkbox", "id": "show_expect", "label": "Show section", "default": true },
    { "type": "text", "id": "exp_heading", "label": "Heading", "default": "What you might feel, and roughly when." },
    { "type": "richtext", "id": "exp_intro", "label": "Intro", "default": "<p>Honest version. Bodies differ. Nobody can promise you a date. Here's the shape of what people tend to report.</p>" },
    { "type": "text", "id": "exp_1_label", "label": "Horizon 1 label", "default": "Weeks 1–4" },
    { "type": "richtext", "id": "exp_1", "label": "Horizon 1", "default": "<p>The early, felt stuff. Usually where people notice something first: hands and feet that aren't as cold, a little less of that heavy, done-by-3pm feeling. Small, but it's the part you can feel. [CITATION NEEDED — early functional timeline / onset]</p>" },
    { "type": "text", "id": "exp_2_label", "label": "Horizon 2 label", "default": "Months 2–3" },
    { "type": "richtext", "id": "exp_2", "label": "Horizon 2", "default": "<p>It settles in. The early changes tend to become the normal state rather than a good day here and there. Taken consistently, at the dose.</p>" },
    { "type": "text", "id": "exp_3_label", "label": "Horizon 3 label", "default": "Longer term" },
    { "type": "richtext", "id": "exp_3", "label": "Horizon 3", "default": "<p>The structural side — supporting healthy circulation and normal blood flow over time, as part of looking after your cardiovascular function. Careful language on purpose: this is support, taken daily, not a fix on a deadline. [CITATION NEEDED — long-term circulatory support]</p>" },
    { "type": "richtext", "id": "exp_close", "label": "Closing", "default": "<p>If someone's selling you a specific week when everything changes, they're guessing louder than we are.</p>" },

    { "type": "header", "content": "5.9 Who should not take this" },
    { "type": "checkbox", "id": "show_safety", "label": "Show section", "default": true },
    { "type": "text", "id": "safety_heading", "label": "Heading", "default": "This isn't right for everyone. Here's who should skip it, or ask first." },
    { "type": "richtext", "id": "safety_body", "label": "Body list", "default": "<p>Most brands won't put this on the page. We'd rather you trust the rest of it. Talk to your doctor before starting if you:</p><ul><li>Take a blood thinner or antiplatelet — warfarin, Eliquis, Xarelto, aspirin, clopidogrel.</li><li>Have a diagnosed bleeding or clotting disorder.</li><li>Have surgery or a dental procedure scheduled — stop at least two weeks beforehand and tell your surgeon.</li><li>Take blood pressure medication (it may compound the effect).</li><li>Have a diagnosed soy allergy. [TODO: confirm soy-allergen status against the COA panel]</li><li>Are pregnant or nursing.</li><li>Are under 18.</li></ul>" },
    { "type": "richtext", "id": "safety_plaque", "label": "Plaque question (objection #2)", "default": "<p><strong>On the \"won't it break plaque loose\" question.</strong> It's fair and it deserves a straight answer instead of silence. Nattokinase supports your body's normal, continuous fibrinolytic activity — the everyday clearing described above — rather than acting on established deposits. It is not a drug that forces anything. [CITATION NEEDED — fibrinolytic safety profile] If you have diagnosed arterial disease, stents, or known plaque, that's exactly the situation where you start with your cardiologist, not a page on the internet.</p>" },
    { "type": "richtext", "id": "safety_reframe", "label": "Reframe", "default": "<p>If a supplement company is willing to tell you who shouldn't buy it, that's usually a sign about how they'll treat you after you do.</p>" },

    { "type": "header", "content": "5.10 Reviews (add reviews as blocks — PLACEHOLDER copy)" },
