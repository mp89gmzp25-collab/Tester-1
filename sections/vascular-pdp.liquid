    { "type": "text", "id": "gtee_heading", "label": "Heading", "default": "Try it for 180 days. Keep the bottle either way." },
    { "type": "richtext", "id": "gtee_body", "label": "Body", "default": "<p>If it's not doing anything for you in 180 days, email us and get your money back. You don't ship the bottle back. That's the deal.</p>" },
    { "type": "text", "id": "cta_label", "label": "CTA button text", "default": "See the bundles" },
