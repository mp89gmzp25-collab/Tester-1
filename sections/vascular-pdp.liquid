    { "type": "richtext", "id": "disclaimer", "label": "FDA / DSHEA disclaimer", "default": "<p>These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>" },

    { "type": "header", "content": "Kaching selectors (fix here if the app updates — no code edit needed)" },
